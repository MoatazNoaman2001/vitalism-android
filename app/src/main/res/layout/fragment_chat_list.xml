<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".models.chatPeopleList.ui.ChatListFragment">


        <com.google.android.material.appbar.MaterialToolbar
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:id="@+id/toolbar"
            app:navigationIcon="@drawable/ic_baseline_arrow_back_ios_24"
            app:navigationIconTint="@color/blue_A200"
            app:title="Chat List"
            app:titleTextColor="@color/blue_A200"
            app:titleCentered="true" />

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/PeopleChatListRecycleView"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:orientation="vertical"
            tools:listitem="@layout/peaple_list_recycle_item"
            tools:itemCount="5"
            android:layout_marginTop="?actionBarSize"
            android:layout_marginHorizontal="12dp" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:gravity="center"
            android:id="@+id/errorLayout"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_100sdp"
                app:tint="@color/blue_A200"
                app:srcCompat="@drawable/ic_connect_without_contact_24" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/errorTextView"
                android:text="@string/this_part_of_application_is_not_available_in_beta_mode"
                android:textColor="@color/blue_A200"
                android:fontFamily="@font/robotomedium"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />
        </androidx.appcompat.widget.LinearLayoutCompat>

    </FrameLayout>
</layout>