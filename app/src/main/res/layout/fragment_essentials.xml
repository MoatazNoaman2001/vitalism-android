<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".models.startActivity.ui.fragments.essitionals.ui.EssentialsFragment">

        <com.example.livenativerppg.models.emr_EMR.ui.CustomMaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@mipmap/ios_back_btn"
            app:title="Additional User Info"
            app:titleTextColor="@color/blue_A200" />


        <LinearLayout
            android:id="@+id/linearColumngrouptwenty"
            style="@style/groupStylecornerRadius_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:gravity="start"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar">


            <LinearLayout
                android:id="@+id/linearRowarrowleft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_10pxh"
                android:gravity="center"
                android:orientation="horizontal">


                <ImageView
                    android:id="@+id/imageRectangleNineteen"
                    android:layout_width="@dimen/_206pxh"
                    android:layout_height="@dimen/_96pxh"
                    android:scaleType="fitXY"
                    android:src="@drawable/img_rectangle19"
                    tools:ignore="ContentDescription" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtSignupnow"
                style="@style/txtArialboldmt26"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="@dimen/_12pxh"
                android:layout_marginTop="@dimen/_8pxv"
                android:layout_marginEnd="@dimen/_12pxh"
                android:ellipsize="end"
                android:lineSpacingExtra="@dimen/_1pxh"
                android:singleLine="true"
                android:text="User Information" />

            <TextView
                android:id="@+id/txtPleasefillthe"
                style="@style/txtAbelregular16_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12pxh"
                android:layout_marginTop="@dimen/_10pxv"
                android:layout_marginEnd="@dimen/_12pxh"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:lineSpacingExtra="@dimen/_1pxh"
                android:singleLine="true"
                android:text="We Just need additional attribute to help monitoring you " />


            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_30sdp"
                android:orientation="vertical">


                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/phoneNumberTextInputLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/phone_number"
                    app:boxCornerRadiusBottomEnd="@dimen/_14sdp"
                    app:boxCornerRadiusBottomStart="@dimen/_14sdp"
                    app:boxCornerRadiusTopEnd="@dimen/_14sdp"
                    app:boxCornerRadiusTopStart="@dimen/_14sdp"
                    app:endIconCheckable="true"
                    app:endIconDrawable="@drawable/round_phone_24"
                    app:endIconTint="@color/blue_A200"
                    app:hintAnimationEnabled="true"
                    app:hintEnabled="true"
                    app:hintTextColor="@color/gray_900">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/txtSolidRounded_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gray_900" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/CalenderEditLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Birth Day"
                    android:textColorHint="@color/gray_900"
                    app:boxBackgroundColor="@color/gray_51"
                    app:boxCornerRadiusBottomEnd="@dimen/_14pxv"
                    app:boxCornerRadiusBottomStart="@dimen/_14pxv"
                    app:boxCornerRadiusTopEnd="@dimen/_14pxv"
                    app:boxCornerRadiusTopStart="@dimen/_14pxv"
                    app:boxStrokeColor="@color/gray_100"
                    app:boxStrokeErrorColor="@color/red_600"
                    app:boxStrokeWidth="1dp"
                    app:counterTextColor="@color/blue_801"
                    app:endIconCheckable="true"
                    app:endIconDrawable="@drawable/ic_calender_24"
                    app:endIconMode="custom"
                    app:endIconTint="@color/blue_801"
                    app:hintAnimationEnabled="true"
                    app:hintEnabled="true"
                    app:hintTextColor="@color/gray_900"
                    tools:hint="Birth Day">

                    <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                        android:id="@+id/CalenderCompleteTextView"
                        style="@style/txtSolidRounded_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:paddingStart="8dp"
                        android:textColor="@color/gray_900" />
                </com.google.android.material.textfield.TextInputLayout>

                <EditText
                    android:id="@+id/CountryEditText"
                    style="@style/txtSolidRounded_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5pxv"
                    android:ellipsize="end"
                    android:hint="@string/lbl_country"
                    android:lineSpacingExtra="@dimen/_1pxh"
                    android:paddingStart="@dimen/_12pxh"
                    android:paddingTop="@dimen/_15pxv"
                    android:paddingBottom="@dimen/_18pxv"
                    android:singleLine="true"
                    android:textColor="@color/gray_900"
                    tools:text="@string/lbl_country" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/BloodTypeEditLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/lbl_blood_type"
                    android:textColorHint="@color/gray_900"
                    app:boxBackgroundColor="@color/gray_51"
                    app:boxCornerRadiusBottomEnd="@dimen/_14pxv"
                    app:boxCornerRadiusBottomStart="@dimen/_14pxv"
                    app:boxCornerRadiusTopEnd="@dimen/_14pxv"
                    app:boxCornerRadiusTopStart="@dimen/_14pxv"
                    app:boxStrokeColor="@color/gray_100"
                    app:boxStrokeErrorColor="@color/red_600"
                    app:boxStrokeWidth="1dp"
                    app:counterTextColor="@color/blue_801"
                    app:endIconMode="dropdown_menu"
                    app:endIconTint="@color/blue_801"
                    app:hintAnimationEnabled="true"
                    app:hintEnabled="true"
                    app:hintTextColor="@color/gray_900"
                    tools:hint="@string/lbl_blood_type">

                    <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                        android:id="@+id/bloodTypeCompleteTextView"
                        style="@style/txtSolidRounded_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:textColor="@color/gray_900" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/DiagnosesEditLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/lbl_diagnoses"
                    android:textColorHint="@color/gray_900"
                    app:boxBackgroundColor="@color/gray_51"
                    app:boxCornerRadiusBottomEnd="@dimen/_14pxv"
                    app:boxCornerRadiusBottomStart="@dimen/_14pxv"
                    app:boxCornerRadiusTopEnd="@dimen/_14pxv"
                    app:boxCornerRadiusTopStart="@dimen/_14pxv"
                    app:boxStrokeColor="@color/gray_100"
                    app:boxStrokeErrorColor="@color/red_600"
                    app:boxStrokeWidth="1dp"
                    app:counterTextColor="@color/blue_801"
                    app:endIconMode="dropdown_menu"
                    app:endIconTint="@color/blue_801"
                    app:hintAnimationEnabled="true"
                    app:hintEnabled="true"
                    tools:hint="@string/lbl_diagnoses">

                    <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                        android:id="@+id/DiagnosesCompleteTextView"
                        style="@style/txtSolidRounded_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:textColor="@color/gray_900" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/GenderEditLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Gender"
                    android:textColorHint="@color/gray_900"
                    app:boxBackgroundColor="@color/gray_51"
                    app:boxCornerRadiusBottomEnd="@dimen/_14pxv"
                    app:boxCornerRadiusBottomStart="@dimen/_14pxv"
                    app:boxCornerRadiusTopEnd="@dimen/_14pxv"
                    app:boxCornerRadiusTopStart="@dimen/_14pxv"
                    app:boxStrokeColor="@color/gray_100"
                    app:boxStrokeErrorColor="@color/red_600"
                    app:boxStrokeWidth="1dp"
                    app:counterTextColor="@color/blue_801"
                    app:endIconMode="dropdown_menu"
                    app:endIconTint="@color/blue_801"
                    app:hintAnimationEnabled="true"
                    app:hintEnabled="true">

                    <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                        android:id="@+id/GenderCompleteTextView"
                        style="@style/txtSolidRounded_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:textColor="@color/gray_900" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/WeightTextInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:hint="weight"
                        app:boxCornerRadiusBottomEnd="@dimen/_14sdp"
                        app:boxCornerRadiusBottomStart="@dimen/_14sdp"
                        app:boxCornerRadiusTopEnd="@dimen/_14sdp"
                        app:boxCornerRadiusTopStart="@dimen/_14sdp"
                        app:endIconCheckable="true"
                        app:endIconDrawable="@drawable/round_phone_24"
                        app:endIconTint="@color/blue_A200"
                        app:hintAnimationEnabled="true"
                        app:hintEnabled="true"
                        app:hintTextColor="@color/gray_900">

                        <com.google.android.material.textfield.TextInputEditText
                            style="@style/txtSolidRounded_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="@color/gray_900" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/HeightTextInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:hint="height"
                        app:boxCornerRadiusBottomEnd="@dimen/_14sdp"
                        app:boxCornerRadiusBottomStart="@dimen/_14sdp"
                        app:boxCornerRadiusTopEnd="@dimen/_14sdp"
                        app:boxCornerRadiusTopStart="@dimen/_14sdp"
                        app:endIconCheckable="true"
                        app:endIconDrawable="@drawable/round_phone_24"
                        app:endIconTint="@color/blue_A200"
                        app:hintAnimationEnabled="true"
                        app:hintEnabled="true"
                        app:hintTextColor="@color/gray_900">

                        <com.google.android.material.textfield.TextInputEditText
                            style="@style/txtSolidRounded_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="@color/gray_900" />
                    </com.google.android.material.textfield.TextInputLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>


        </LinearLayout>


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/addfingerPrint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/interbold"
            android:gravity="center"
            android:drawableTop="@drawable/img_fingerprint"
            android:drawableTint="@color/blue_A400"
            android:text="add fingerprint"
            android:visibility="gone"
            tools:visibility="visible"
            android:textColor="@color/blue_A400"
            app:fontFamily="@font/archivo_bold"
            app:layout_constraintBottom_toTopOf="@+id/Next"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar"
            app:layout_constraintVertical_bias="0.98" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/Next"
            android:layout_width="@dimen/_120sdp"
            android:layout_height="wrap_content"
            android:text="Next"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.95" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressIndecator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/Next"
            app:layout_constraintEnd_toEndOf="@id/Next"
            app:layout_constraintStart_toStartOf="@id/Next"
            app:layout_constraintTop_toTopOf="@+id/Next" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/materialButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="skip"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.95"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.95" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>