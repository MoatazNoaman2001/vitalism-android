            app:navigationIconTint="@color/black_900"
            app:title="@{ScheduleVM.scheduleModel.txtYourMedication}"
            app:menu="@menu/schedule_menu"
            app:titleCentered="true"
            app:titleTextAppearance="@style/txtArialboldmt18"
            tools:title="@string/msg_your_medication">

