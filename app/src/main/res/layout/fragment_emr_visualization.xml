<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".models.emrVitualize.ui.EmrVisualizationFragment">
        <com.google.android.material.appbar.MaterialToolbar
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:id="@+id/toolbar"
            app:navigationIcon="@drawable/ic_baseline_arrow_back_ios_24"
            app:navigationIconTint="@color/white"
            app:title="emr"
            app:titleTextColor="@color/white"
            android:background="@color/blue_A400"/>
        <com.shrikanthravi.collapsiblecalendarview.widget.CollapsibleCalendar
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:primaryColor="@color/blue_A400"
            app:textColor="@color/white"
            app:todayItem_textColor="@color/white"
            app:expandIconColor="@color/white"
            app:selectedItem_textColor="@color/green_A400"
            app:datePattern="EEEE dd MMM"
            app:showWeek="true"
            app:state="collapsed"
            android:id="@+id/calendarView"/>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="wrap_content">


                <com.github.mikephil.charting.charts.LineChart
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_200sdp"
                    android:id="@+id/MeasureChart" />
                <com.github.mikephil.charting.charts.LineChart
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_250sdp"
                    android:id="@+id/ResultChart"/>
                <com.github.mikephil.charting.charts.BarChart
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_200sdp"
                    android:id="@+id/BarChart" />

                <!--            <com.michalsvec.singlerowcalendar.calendar.SingleRowCalendar-->
                <!--                android:layout_width="match_parent"-->
                <!--                android:layout_height="wrap_content"-->
                <!--                app:stackFromEnd="true"-->
                <!--                android:id="@+id/calendar"-->
                <!--                app:longPress="false"-->
                <!--                app:multiSelection="false"-->
                <!--                app:deselection="false"/>-->
                <!--                -->
            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.core.widget.NestedScrollView>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>