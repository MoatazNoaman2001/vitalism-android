                                        android:ellipsize="end"
                                        android:gravity="center_horizontal"
                                        android:letterSpacing="0.03"
                                        android:lineSpacingExtra="@dimen/_1pxh"
                                        android:singleLine="true"
                                        android:text="@{profileVM.profileModel.txtNoneOne}"
