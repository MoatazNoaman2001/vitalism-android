            android:layout_width="match_parent"
            app:title="@{profileVM.profileModel.txtProfile}"
            app:titleTextAppearance="@style/txtArialboldmt24"
            tools:title="@string/lbl_profile"
            app:titleTextColor="@color/blue_A200"
            android:layout_marginStart="@dimen/_8sdp"
            app:navigationIcon="@mipmap/ios_back_btn_blue"
            android:overScrollMode="ifContentScrolls"
            app:menu="@menu/profile_menu"
