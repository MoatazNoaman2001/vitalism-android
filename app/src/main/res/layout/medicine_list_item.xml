<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>

    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/_90sdp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:id="@+id/linearRowrectangletwentynine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center"
            android:layout_marginStart="@dimen/_11pxh"
            android:layout_marginTop="@dimen/_10pxv"
            android:layout_marginEnd="@dimen/_11pxh"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/MedicineImg"
                cornerRadius="@{@dimen/_16pxh}"
                imageRes="@{@drawable/img_rectangle29}"
                android:layout_width="@dimen/_95pxh"
                android:layout_height="@dimen/_82pxh"
                android:layout_marginBottom="@dimen/_62pxv"
                android:scaleType="fitXY"
                tools:ignore="ContentDescription"
                tools:src="@drawable/img_rectangle29" />

            <LinearLayout
                android:id="@+id/linearColumncalendar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_19pxh"
                android:layout_marginTop="@dimen/_4pxv"
                android:layout_weight="0.69"
                android:gravity="start"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/linearRowcalendar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_10pxh"
                    android:gravity="start"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imageCalendar"
                        android:layout_width="@dimen/_14pxh"
                        android:layout_height="@dimen/_12pxh"
                        android:layout_marginStart="@dimen/_2pxh"
                        android:layout_marginTop="@dimen/_2pxv"
                        android:layout_marginBottom="@dimen/_1pxv"
                        android:scaleType="fitXY"
                        android:src="@drawable/img_calendar"
                        tools:ignore="ContentDescription"
                        tools:src="@drawable/img_calendar" />

                    <TextView
                        android:id="@+id/txtDate"
                        style="@style/txtAbelregular13"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_9pxh"
                        android:layout_marginBottom="@dimen/_4pxv"
                        android:ellipsize="end"
                        android:letterSpacing="0.02"
                        android:lineSpacingExtra="@dimen/_1pxh"
                        android:singleLine="true"
                        tools:text="@string/msg_23_november_202" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtName"
                    style="@style/txtAbelregular16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_1pxh"
                    android:layout_marginTop="@dimen/_10pxv"
                    android:layout_marginEnd="@dimen/_10pxh"
                    android:ellipsize="end"
                    android:letterSpacing="0.03"
                    android:lineSpacingExtra="@dimen/_1pxh"
                    android:singleLine="true"
                    tools:text="@string/msg_miglitol_glyse" />

                <TextView
                    android:id="@+id/txtDisc"
                    style="@style/txtAbelregular13"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_1pxh"
                    android:layout_marginTop="@dimen/_2pxv"
                    android:layout_marginEnd="@dimen/_10pxh"
                    android:letterSpacing="0.02"
                    android:lineSpacingExtra="@dimen/_3pxh"
                    tools:text="@string/msg_miglitol_glyse2" />

                <ImageView
                    android:id="@+id/imageLocation"
                    android:layout_width="@dimen/_16pxh"
                    android:layout_height="@dimen/_15pxh"
                    android:layout_marginStart="@dimen/_24pxh"
                    android:layout_marginTop="@dimen/_43pxv"
                    android:layout_marginEnd="@dimen/_24pxh"
                    android:layout_marginBottom="@dimen/_1pxv"
                    android:scaleType="fitXY"
                    android:src="@drawable/img_location"
                    tools:ignore="ContentDescription"
                    tools:src="@drawable/img_location" />
            </LinearLayout>

            <ImageView
                android:id="@+id/imageArrowleftOne"
                android:layout_width="@dimen/_6pxh"
                android:layout_height="@dimen/_11pxh"
                android:layout_marginStart="@dimen/_17pxh"
                android:layout_marginTop="@dimen/_35pxv"
                android:layout_marginBottom="@dimen/_98pxv"
                android:scaleType="fitXY"
                android:src="@drawable/img_arrowleft_bluegray_400"
                tools:ignore="ContentDescription"
                tools:src="@drawable/img_arrowleft_bluegray_400" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</layout>