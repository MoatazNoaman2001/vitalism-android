<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        tools:context=".models.setting.ui.ProfileSettingFragment">

        <com.example.livenativerppg.models.emr_EMR.ui.CustomMaterialToolbar
            android:layout_width="match_parent"
            android:id="@+id/toolbar"
            android:transitionName="toolbar_title"
            android:layout_height="?actionBarSize"
            app:navigationIcon="@mipmap/ios_back_btn_blue"
            app:title="setting"
            app:subtitle="still working on"
            app:subtitleTextColor="@color/blue_A200"
            app:subtitleCentered="true"
            app:titleTextColor="@color/blue_A200"
            android:layout_marginStart="@dimen/_8sdp"
            app:titleCentered="true"
            app:menu="@menu/setting_toolbar_menu"
            />

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/SettingMainRecycleView"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:orientation="vertical"
            tools:itemCount="2"
            tools:listitem="@layout/setting_recycleview_item"/>


    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>